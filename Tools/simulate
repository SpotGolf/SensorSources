#!/usr/bin/env python3
"""Plays a recorded round to an app on a simulator: GPS fixes through `simctl location`, and
sensor clips through the app's mock sensors, all at their recorded pace.

    simulate <simulation dir> --watch <simulator> --bundle <bundle id> [--phone <simulator>]
             [--from MIN] [--to MIN] [--lead SECONDS] [--list]

A simulation folder holds:

    simulation.json   name, and optionally "greens": [{"hole", "t", "duration"}] for --list
    location.csv      t,lat,lon[,alt,hacc]   t in seconds from the simulation's start
    clips.csv         t,clip                 when each clip in clips/ starts
    clips/<name>.clip clip folders as the mock sensors read them

--from and --to pick a part of the simulation, in minutes from its start. Each clip is sent
--lead seconds ahead with its start time in clip.json, so a large clip is read before it
plays. The phone, when given, gets every 10th fix, which is enough to show where the player is.
"""
import argparse, csv, json, os, shutil, subprocess, sys, threading, time
from concurrent.futures import ThreadPoolExecutor


def read_rows(path):
    with open(path, newline="") as f:
        return list(csv.DictReader(f))


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("simulation")
    parser.add_argument("--watch", help="simulator name or UDID that runs the app with mock sensors")
    parser.add_argument("--bundle", help="bundle ID of the app with mock sensors")
    parser.add_argument("--phone", help="a second simulator that gets the location too")
    parser.add_argument("--from", dest="start", type=float, default=0, help="minutes from the start")
    parser.add_argument("--to", dest="end", type=float, default=None, help="minutes from the start")
    parser.add_argument("--lead", type=float, default=30, help="seconds each clip is sent ahead")
    parser.add_argument("--list", action="store_true", help="print the simulation's greens and exit")
    args = parser.parse_args()

    folder = args.simulation
    meta = json.load(open(os.path.join(folder, "simulation.json")))
    fixes = [(float(r["t"]), r["lat"], r["lon"]) for r in read_rows(os.path.join(folder, "location.csv"))]
    clips = [(float(r["t"]), r["clip"]) for r in read_rows(os.path.join(folder, "clips.csv"))]
    if args.list:
        print(meta.get("name", folder))
        for green in meta.get("greens", []):
            print("  hole %-3s green at %6.1f min for %4.0f s" % (green["hole"], green["t"] / 60, green["duration"]))
        print("  ends at %.1f min" % (max(t for t, *_ in fixes) / 60))
        return
    if not args.watch or not args.bundle:
        parser.error("--watch and --bundle are needed to run a simulation")

    start = args.start * 60
    end = args.end * 60 if args.end is not None else float("inf")
    fixes = [f for f in fixes if start <= f[0] < end]
    clips = [c for c in clips if start <= c[0] < end]
    container = subprocess.run(["xcrun", "simctl", "get_app_container", args.watch, args.bundle, "data"],
                               check=True, capture_output=True, text=True).stdout.strip()
    inbox = os.path.join(container, "Library", "SensorMock", "Inbox")
    os.makedirs(inbox, exist_ok=True)

    # Wall-clock time of simulation time `start`; a little ahead, so the first clips can be sent early
    origin = time.time() + min(args.lead, 5)
    at = lambda t: origin + (t - start)
    events = [(t, "fix", (lat, lon), i) for i, (t, lat, lon) in enumerate(fixes)]
    events += [(t - args.lead, "clip", (t, name), 0) for t, name in clips]
    events.sort(key=lambda e: (e[0], e[1]))
    print("%s: %d fixes and %d clips from %.1f to %.1f min" % (
        meta.get("name", folder), len(fixes), len(clips), start / 60,
        (min(end, max([t for t, *_ in fixes] or [start]))) / 60), flush=True)

    sender = ThreadPoolExecutor(max_workers=1)
    failures = []

    def send_clip(t, name):
        source = os.path.join(folder, "clips", name)
        hidden = os.path.join(inbox, "." + name)
        try:
            shutil.rmtree(hidden, ignore_errors=True)
            shutil.copytree(source, hidden)
            with open(os.path.join(hidden, "clip.json"), "w") as f:
                json.dump({"startAt": at(t)}, f)
            os.rename(hidden, os.path.join(inbox, name))
        except OSError as error:
            failures.append(name)
            print("Could not send %s: %s" % (name, error), file=sys.stderr, flush=True)

    last_report = 0
    try:
        for when, kind, payload, index in events:
            delay = at(when) - time.time()
            if delay > 0:
                time.sleep(delay)
            if kind == "fix":
                lat, lon = payload
                subprocess.run(["xcrun", "simctl", "location", args.watch, "set", "%s,%s" % (lat, lon)], check=False)
                if args.phone and index % 10 == 0:
                    subprocess.run(["xcrun", "simctl", "location", args.phone, "set", "%s,%s" % (lat, lon)], check=False)
            else:
                t, name = payload
                if not name.startswith("swing-"):
                    print("%6.1f min  %s" % (t / 60, name), flush=True)
                sender.submit(send_clip, t, name)
            if when - last_report >= 300:
                last_report = when
                print("%6.1f min" % (when / 60), flush=True)
    except KeyboardInterrupt:
        print("Stopped", flush=True)
    sender.shutdown(wait=True)
    if failures:
        sys.exit("%d clips could not be sent" % len(failures))


if __name__ == "__main__":
    main()
